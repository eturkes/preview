#!/bin/sh
# Checkout-bound Bun launcher; remains valid when reached through an install symlink.
set -eu

self=$(readlink -f -- "$0")
root=$(CDPATH='' cd -- "$(dirname -- "$self")/.." && pwd -P)

if command -v bun >/dev/null 2>&1; then
  exec bun "$root/src/main.ts" "$@"
fi
if [ -x "$root/node_modules/.bin/bun" ]; then
  exec "$root/node_modules/.bin/bun" "$root/src/main.ts" "$@"
fi
printf '%s\n' 'preview: Bun is unavailable; run pnpm install in the Preview checkout' >&2
exit 127
